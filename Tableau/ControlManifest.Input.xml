<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="MAESTRO" constructor="Tableau" version="0.1.01" display-name-key="Tableau" description-key="Tableau description" control-type="virtual" >
    <!--external-service-usage node declares whether this 3rd party PCF control is using external service or not, if yes, this control will be considered as premium and please also add the external domain it is using.
    If it is not using any external service, please set the enabled="false" and DO NOT add any domain below. The "enabled" will be false by default.
    Example1:
      <external-service-usage enabled="true">
        <domain>www.Microsoft.com</domain>
      </external-service-usage>
    Example2:
      <external-service-usage enabled="false">
      </external-service-usage>
    -->
    <external-service-usage enabled="false">
      <!--UNCOMMENT TO ADD EXTERNAL DOMAINS
      <domain></domain>
      <domain></domain>
      -->
    </external-service-usage>
    <!-- property node identifies a specific, configurable piece of data that the control expects from CDS -->
    <property name="dataJson" display-name-key="Données JSON" description-key="Chaîne JSON contenant le tableau des prestations" of-type="Multiple" usage="input" required="true" />
    <property name="favoritesDataJson" display-name-key="Données favoris JSON" description-key="Chaîne JSON contenant les favoris (GUID ou objets)" of-type="Multiple" usage="input" required="false" />
    <property name="jalonsLivrables" display-name-key="Nombre items jalonsLivrables" description-key="JalonsLivrables" of-type="Multiple" usage="input" required="false" />
    
    <property name="nbItems" display-name-key="Nombre d items" description-key="Item" of-type="Whole.None" usage="input" required="false" />



    <property name="actionJson" display-name-key="Action JSON" description-key="JSON décrivant la dernière action utilisateur (refresh|favorite|navigate|showTooltip)" of-type="SingleLine.Text" usage="output" required="false" />
    
    <property name="selectedIdPrestation" display-name-key="Selected ID Prestation" description-key="ID de la prestation sélectionnée" of-type="SingleLine.Text" usage="output" required="false" />
    <property name="selectedGuid" display-name-key="Selected Guid" description-key="Selected Guid" of-type="SingleLine.Text" usage="output" />
    <property name="selectedLibPrestation" display-name-key="Selected Lib Prestation" description-key="Libellé de la prestation sélectionnée" of-type="SingleLine.Text" usage="output" required="false" />

    <property name="favoritesJson" display-name-key="Favoris JSON" description-key="JSON des GUID favoris (sortie)" of-type="SingleLine.Text" usage="output" required="false" />

    <property
        name="refreshKey"
        display-name-key="refreshKey"
        of-type="SingleLine.Text"
        usage="input"
    />

    <event name="OnProjectSelect" display-name-key="OnSelect projet" description-key="Expression Power Fx executee lors du clic sur un projet" />
    <event name="OnProjectFavorisToggle" display-name-key="OnFavorisToggle projet" description-key="Expression Power Fx executee lors du clic sur un projet favori" />

    

    <!--
      Property node's of-type attribute can be of-type-group attribute.
      Example:
      <type-group name="numbers">
        <type>Whole.None</type>
        <type>Currency</type>
        <type>FP</type>
        <type>Decimal</type>
      </type-group>
      <property name="sampleProperty" display-name-key="Property_Display_Key" description-key="Property_Desc_Key" of-type-group="numbers" usage="bound" required="true" />
    -->
    <resources>
      <code path="index.ts" order="1"/>
      <platform-library name="React" version="16.14.0" />
      <platform-library name="Fluent" version="9.46.2" />
      <!-- UNCOMMENT TO ADD MORE RESOURCES
      <css path="css/Tableau.css" order="1" />
      <resx path="strings/Tableau.1033.resx" version="1.0.0" />
      -->
    </resources>
    <!-- UNCOMMENT TO ENABLE THE SPECIFIED API
    <feature-usage>
      <uses-feature name="Device.captureAudio" required="true" />
      <uses-feature name="Device.captureImage" required="true" />
      <uses-feature name="Device.captureVideo" required="true" />
      <uses-feature name="Device.getBarcodeValue" required="true" />
      <uses-feature name="Device.getCurrentPosition" required="true" />
      <uses-feature name="Device.pickFile" required="true" />
      <uses-feature name="Utility" required="true" />
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>
    -->
  </control>
</manifest>
