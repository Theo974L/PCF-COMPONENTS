<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="MAESTRO" constructor="Tableau" version="0.2.01" display-name-key="Tableau" description-key="Tableau description" control-type="virtual">
    <!--external-service-usage node declares whether this 3rd party PCF control is using external service or not, if yes, this control will be considered as premium and please also add the external domain it is using.
    If it is not using any external service, please set the enabled="false" and DO NOT add any domain below. The "enabled" will be false by default.
    Example1:
      
    Example2:
      <external-service-usage enabled="false">
      </external-service-usage>
    -->
    
    <external-service-usage enabled="false">
      <!--UNCOMMENT TO ADD EXTERNAL DOMAINS
      <domain></domain>
      <domain></domain>
      -->
    </external-service-usage>
    <!-- property node identifies a specific, configurable piece of data that the control expects from CDS -->
   
    <property name="notificationType" display-name-key="Type de notification" description-key="Type de la notification : success, info, warning, error, alert" of-type="SingleLine.Text" usage="input" required="false" />
    <property name="notificationTitle" display-name-key="Titre notification" description-key="Titre affiché avant le message" of-type="SingleLine.Text" usage="input" required="false" />
    <property name="notificationIcon" display-name-key="Icône notification" description-key="Emoji ou texte affiché en icône de notification" of-type="SingleLine.Text" usage="input" required="false" />
    <property name="notificationMessage" display-name-key="Message notification" description-key="Message affiché par Toastify" of-type="SingleLine.Text" usage="input" required="false" />
    <property name="notificationPosition" display-name-key="Position notification" description-key="Position de la notification : top-right, top-left, bottom-right, bottom-left, top-center, bottom-center" of-type="SingleLine.Text" usage="input" required="false" />
    <property name="notificationTheme" display-name-key="Theme notification" description-key="Theme de la notification : light, dark, colored" of-type="SingleLine.Text" usage="input" required="false" />
    <property name="notificationCloseOnClick" display-name-key="Fermer au clic" description-key="True/false : fermer la notification au clic" of-type="SingleLine.Text" usage="input" required="false" />
    <property name="notificationPauseOnHover" display-name-key="Pause au survol" description-key="True/false : arrêter le compte à rebours au survol" of-type="SingleLine.Text" usage="input" required="false" />
    <property name="notificationHideProgressBar" display-name-key="Masquer barre de progression" description-key="True/false : cacher la barre de progression" of-type="SingleLine.Text" usage="input" required="false" />
    <property name="notificationActionUrl" display-name-key="URL action" description-key="URL à ouvrir au clic sur la notification" of-type="SingleLine.Text" usage="input" required="false" />
    <property name="notificationTrigger" display-name-key="Déclencheur notification" description-key="Valeur unique permettant de déclencher la notification" of-type="SingleLine.Text" usage="input" required="false" />
    <property name="notificationAutoClose" display-name-key="Durée auto close" description-key="Durée en millisecondes avant fermeture automatique" of-type="Whole.None" usage="input" required="false" />

    <event 
    name="OnProjectFavorisToggle" 
    display-name-key="OnFavorisToggle projet" 
    description-key="Expression Power Fx executee lors du clic sur un projet favori" 
    />


    
    



    <!--
      Property node's of-type attribute can be of-type-group attribute.
      Example:
      <type-group name="numbers">
        <type>Whole.None</type>
        <type>Currency</type>
        <type>FP</type>
        <type>Decimal</type>
      </type-group>
      <property name="sampleProperty" display-name-key="Property_Display_Key" description-key="Property_Desc_Key" of-type-group="numbers" usage="bound" required="true" />
    -->
    <resources>
      <code path="index.ts" order="1"/>
      <platform-library name="React" version="16.14.0" />
      <platform-library name="Fluent" version="9.46.2" />
      <!-- UNCOMMENT TO ADD MORE RESOURCES
      <css path="css/Tableau.css" order="1" />
      <resx path="strings/Tableau.1033.resx" version="1.0.0" />
      -->
    </resources>
    <!-- UNCOMMENT TO ENABLE THE SPECIFIED API
    <feature-usage>
      <uses-feature name="Device.captureAudio" required="true" />
      <uses-feature name="Device.captureImage" required="true" />
      <uses-feature name="Device.captureVideo" required="true" />
      <uses-feature name="Device.getBarcodeValue" required="true" />
      <uses-feature name="Device.getCurrentPosition" required="true" />
      <uses-feature name="Device.pickFile" required="true" />
      <uses-feature name="Utility" required="true" />
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>
    -->
  </control>
</manifest>
